{
  "name": "flipscout-ext",
  "version": "0.1.0",
  "private": true,
  "description": "FlipScout browser extension - one-tap capture of eBay / Facebook Marketplace listings into your flip tracker",
  "dependencies": {
    "@types/chrome": "^0.0.243",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && npm run post-build",
    "post-build": "node scripts/post-build.js",
    "icons": "node scripts/make-icons.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
